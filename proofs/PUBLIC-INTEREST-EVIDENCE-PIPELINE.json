      "newOriginalApprovedByThisCharter": false
    },
    {
      "id": "engineering",
      "description": "Original bounded engineering proofs, receipts, tamper and replays",
      "reviewStatus": "OPEN_TO_MAXIMUM_SAFE_DISCLOSURE",
      "source": "proofs/HISTORICAL-EVIDENCE-INDEX.md",
      "newOriginalApprovedByThisCharter": false
    },
    {
      "id": "historical_pilots",
      "description": "Actual completed historical pilot functional outcomes and evidence",
      "reviewStatus": "ORIGINAL_BY_ORIGINAL_RIGHTS_AND_SAFETY_REVIEW_REQUIRED",

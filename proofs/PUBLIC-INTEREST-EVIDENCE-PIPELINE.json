{
  "schema": "va-public-interest-evidence-pipeline/1.0",
  "charterVersion": "2026-10-25",
  "controllingMission": "Publish the maximum independently verifiable scientific, engineering, historical pilot and safety evidence possible, withholding protected construction, unauthorized source, and information enabling harmful replication or weaponization. Prevention of harm takes priority over commercial exclusivity.",
  "priorityOrder": [
    "PREVENT_HARM_AND_OBEY_LAWFUL_DISCLOSURE_AUTHORITY",

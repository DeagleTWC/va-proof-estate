    "RETAIN_ORIGINAL_EVIDENCE_AND_DISPOSITIVE_FAILURES",
    "COMMERCIAL_EXCLUSIVITY_SUBORDINATE_TO_SAFE_EVIDENCE_PUBLICATION"
  ],
  "allowedDispositions": [
    "RELEASE",
    "NARROW",
    "CONTROLLED_REVIEW",
    "HOLD",
    "REFUSE_PUBLICATION"
